<script>
const PREFIX='cmb-familyfeud-';
const KEY='ff_session_v1';
let ws=null, me=null, room='', host=false, state=null;

const QUESTIONS=[
 {mult:1,q:'¿Qué cosa hace la gente justo después de despertarse?',a:[['Mirar el móvil',35],['Ir al baño',25],['Lavarse la cara / dientes',18],['Desayunar',12],['Ducharse',10]]},
 {mult:1,q:'¿Qué comida suele pedir la gente a domicilio?',a:[['Pizza',36],['Hamburguesa',24],['Sushi',16],['Kebab',13],['Pollo',11]]},
 {mult:1,q:'¿Qué llevas normalmente a la playa?',a:[['Toalla',30],['Crema solar',25],['Bañador',18],['Agua',15],['Gafas de sol',12]]},
 {mult:2,q:'¿Qué animal da más miedo encontrar en casa?',a:[['Serpiente',28],['Araña',27],['Rata',19],['Cucaracha',17],['Ratón',9]]},
 {mult:2,q:'¿Qué haces cuando estás aburrido?',a:[['Mirar series',29],['Mirar el móvil',25],['Jugar',20],['Escuchar música',15],['Dormir',11]]},
 {mult:2,q:'¿Qué se te puede olvidar antes de salir de casa?',a:[['Llaves',34],['Móvil',27],['Cartera',18],['Abrigo',11],['Gafas',10]]},
 {mult:3,q:'¿Qué cosa suele haber en una nevera?',a:[['Leche',25],['Huevos',22],['Agua',19],['Fruta',18],['Queso',16]]},
 {mult:3,q:'¿Qué haces cuando llegas tarde?',a:[['Correr',30],['Pedir disculpas',24],['Avisar',20],['Poner una excusa',15],['Entrar en silencio',11]]},
 {mult:3,q:'¿Qué regalo es fácil de hacer a última hora?',a:[['Dinero',31],['Chocolate',25],['Flores',19],['Tarjeta',14],['Perfume',11]]},
 {mult:3,q:'¿Qué suele hacer la gente los domingos?',a:[['Descansar',30],['Comer en familia',23],['Ver películas',20],['Salir',16],['Dormir mucho',11]]}
];

function $(id){return document.getElementById(id)}
function code(){return Math.random().toString(36).slice(2,7).toUpperCase()}
function nameClean(v){return (v||'Jugador').trim().slice(0,18)||'Jugador'}
function connect(){
  const proto=location.protocol==='https:'?'wss':'ws';
  const wsUrl=(location.host?`${proto}://${location.host}`:'ws://localhost:8080');
  ws=new WebSocket(wsUrl);
  ws.onopen=()=>send({type:'join',room:PREFIX+room.toLowerCase(),name:me,host});
  ws.onmessage=e=>{let m;try{m=JSON.parse(e.data)}catch{return}handle(m)};
  ws.onclose=()=>setTimeout(()=>room&&connect(),1500);
}
function send(x){if(ws&&ws.readyState===1)ws.send(JSON.stringify(x))}
function createRoom(){me=nameClean($('nameCreate').value);room=code();host=true;localStorage.setItem(KEY,JSON.stringify({room,me,host}));connect()}
function joinRoom(){me=nameClean($('nameJoin').value);room=($('roomJoin').value||'').trim().toUpperCase();if(room.length!==5){$('homeMsg').textContent='El código debe tener 5 caracteres.';return}host=false;localStorage.setItem(KEY,JSON.stringify({room,me,host}));connect()}
function handle(m){
  if(m.type==='joined'){showLobby();return}
  if(m.type==='state'){state=m.state;render();return}
  if(m.type==='error')alert(m.message||'Error');
}
function showLobby(){$('home').classList.add('hidden');$('lobby').classList.remove('hidden');$('game').classList.add('hidden');$('result').classList.add('hidden');$('roomBadge').textContent='Sala '+room;$('lobbyCode').textContent=room}
function showGame(){$('home').classList.add('hidden');$('lobby').classList.add('hidden');$('game').classList.remove('hidden');$('result').classList.add('hidden')}
function render(){
 if(!state)return;
 $('roomBadge').textContent='Sala '+room;
 const ps=state.players||[];
 $('players').innerHTML=ps.map(p=>`<div class="player ${p.team==='blue'?'teamBlue':'teamRed'}">${p.name} ${p.host?'⭐':''}<br><span class="small">${p.team==='blue'?'🔵 Azul':'🔴 Rojo'}</span></div>`).join('');
 $('livePlayers').innerHTML=ps.map(p=>`<div class="player ${p.team==='blue'?'teamBlue':'teamRed'}">${p.name} — ${p.team==='blue'?'🔵':'🔴'}</div>`).join('');

 if(state.phase==='lobby'){
   showLobby(); $('startBtn').disabled=!host||ps.length<4; return;
 }
 if(state.phase==='finished'){
   $('winnerTitle').textContent='🏆 '+(state.scores.blue>state.scores.red?'¡Gana Azul!':state.scores.red>state.scores.blue?'¡Gana Rojo!':'¡Empate!');
   $('winnerText').textContent=`Resultado final: Azul ${state.scores.blue} — Rojo ${state.scores.red}`;
   $('result').classList.remove('hidden'); $('game').classList.add('hidden'); return;
 }

 showGame();
 $('blueScore').textContent=state.scores.blue;
 $('redScore').textContent=state.scores.red;

 if(state.phase==='fastmoney'){
   $('turnInfo').textContent='⚡ FAST MONEY';
   $('roundInfo').textContent='Ronda final';
   $('question').textContent=state.fastMoney.player?`Jugador: ${state.fastMoney.player}`:'Elige al jugador';
   $('faceoff').textContent=state.fastMoney.player?`Pregunta ${Math.min(state.fastMoney.index+1,5)} de 5`:'';
   $('multiplier').textContent='Objetivo: 200 puntos';
   $('answers').innerHTML=state.fastMoney.answers.map((x,i)=>`<div class="answer revealed"><span>${i+1}. ${x}</span></div>`).join('');
   $('strikes').textContent='';
   $('controls').innerHTML=host
     ? `<button onclick="startFastMoney()">Elegir jugador</button><button class="gold" onclick="fastAnswer()" ${state.fastMoney.player?'':'disabled'}>Siguiente pregunta</button>`
     : `<span class="small">Fast Money en curso.</span>`;
   return;
 }

 const q=QUESTIONS[state.questionIndex];
 $('turnInfo').textContent=state.phase==='faceoff'?'⚡ ENFRENTAMIENTO':
   state.phase==='steal'?'🔥 ROBO':
   (state.currentTeam==='blue'?'Turno del EQUIPO AZUL':'Turno del EQUIPO ROJO');
 $('roundInfo').textContent=`Ronda ${state.round+1} / 5`;
 $('question').textContent=q.q;
 $('faceoff').textContent=state.phase==='faceoff'?'Los dos equipos compiten por encontrar la respuesta mejor situada.':'';
 $('multiplier').textContent=`Multiplicador de esta ronda: x${q.mult}`;
 $('boardHint').textContent=`Puntos de la ronda: ${state.roundPoints}`;
 $('answers').innerHTML=q.a.map((x,i)=>`<div class="answer ${state.board[i]?'revealed':''}"><span>${state.board[i]?x[0]:'???'}</span><span class="pts">${state.board[i]?x[1]:'—'}</span></div>`).join('');
 $('strikes').textContent='✕ '.repeat(state.strikes||0);

 let c='';
 if(host&&state.phase==='faceoff'){
   const blue=state.players.find(p=>p.team==='blue'), red=state.players.find(p=>p.team==='red');
   c=`<span class="hostOnly small">Pregunta a los dos jugadores y pulsa el equipo cuya respuesta coincida.</span>
   <button onclick="answerFaceoff('blue','${blue?blue.name:'Azul'}')">🔵 Respuesta Azul</button>
   <button class="red" onclick="answerFaceoff('red','${red?red.name:'Rojo'}')">🔴 Respuesta Rojo</button>`;
 }else if(host&&state.phase==='playing'){
   c=`<button onclick="revealAnswer()">Revelar respuesta</button>
   <button class="red" onclick="strike()">❌ Strike</button>
   <button class="gold" onclick="nextRound()">${state.strikes>=3?'Pasar al ROBO':'Cerrar ronda'}</button>`;
 }else if(host&&state.phase==='steal'){
   c=`<button class="gold" onclick="steal()">🔥 Resolver ROBO</button>`;
 }else c=`<span class="small">El anfitrión controla el tablero. Podéis responder en voz alta.</span>`;
 $('controls').innerHTML=c;
}

function baseState(){
 return {
  phase:'lobby',players:[],scores:{blue:0,red:0},round:0,questionIndex:0,
  currentTeam:'blue',board:[false,false,false,false,false],strikes:0,target:300,
  faceoff:{blue:null,red:null},faceoffWinner:null,roundPoints:0,roundLocked:false,
  fastMoney:{active:false,player:null,answers:[],score:0,index:0}
 };
}
function hostStateMutation(fn){if(!host||!state)return;fn();broadcast()}
function broadcast(){send({type:'set_state',room:PREFIX+room.toLowerCase(),state})}

function startGame(){
 hostStateMutation(()=>{
  if(state.players.length<4)return;
  state.phase='faceoff'; state.round=0; state.questionIndex=0;
  state.currentTeam='blue'; state.board=[false,false,false,false,false];
  state.strikes=0; state.faceoff={blue:null,red:null}; state.faceoffWinner=null;
  state.roundPoints=0; state.roundLocked=false;
 });
}

function answerFaceoff(team,playerName){
 hostStateMutation(()=>{
  if(state.phase!=='faceoff'||state.faceoff[team])return;
  const q=QUESTIONS[state.questionIndex];
  let ans=prompt('Escribe la respuesta que dio '+playerName+'.\nDebe coincidir exactamente con una respuesta del tablero.');
  if(ans===null)return;
  let idx=q.a.findIndex(x=>x[0].toLowerCase()===ans.trim().toLowerCase());
  state.faceoff[team]={player:playerName,index:idx};
  if(idx>=0){
    state.board[idx]=true;
    state.faceoffWinner=team;
    state.currentTeam=team;
    state.roundPoints=q.a[idx][1];
    state.phase='playing';
    state.strikes=0;
  }
 });
}

function revealAnswer(){
 hostStateMutation(()=>{
  if(state.phase!=='playing')return;
  let i=state.board.findIndex(v=>!v); if(i<0)return;
  state.board[i]=true;
  state.roundPoints+=QUESTIONS[state.questionIndex].a[i][1];
 });
}

function strike(){
 hostStateMutation(()=>{
  if(state.phase!=='playing')return;
  state.strikes++;
  if(state.strikes>=3)state.roundLocked=true;
 });
}

function steal(){
 hostStateMutation(()=>{
  if(state.phase!=='steal')return;
  const q=QUESTIONS[state.questionIndex];
  let ans=prompt('ROBO: escribe la respuesta dada por el equipo rival.');
  if(ans===null)return;
  let idx=q.a.findIndex(x=>x[0].toLowerCase()===ans.trim().toLowerCase());
  if(idx>=0){
    state.board[idx]=true;
    state.roundPoints+=q.a[idx][1];
    state.scores[state.currentTeam]+=state.roundPoints*q.mult;
  }else{
    const other=state.currentTeam==='blue'?'red':'blue';
    state.scores[other]+=state.roundPoints*q.mult;
  }
  finishRoundInternal();
 });
}

function nextRound(){
 hostStateMutation(()=>{
  if(state.phase==='playing' && state.strikes>=3){
    state.currentTeam=state.currentTeam==='blue'?'red':'blue';
    state.phase='steal';
    return;
  }
  if(state.phase==='playing'){
    state.scores[state.currentTeam]+=state.roundPoints*QUESTIONS[state.questionIndex].mult;
    finishRoundInternal();
  }
 });
}

function finishRoundInternal(){
 state.round++;
 if(state.scores.blue>=state.target||state.scores.red>=state.target){state.phase='finished';return;}
 if(state.round>=5){
   state.phase='fastmoney';
   state.fastMoney={active:true,player:null,answers:[],score:0,index:0};
   return;
 }
 state.questionIndex=(state.questionIndex+1)%QUESTIONS.length;
 state.currentTeam=state.round%2===0?'blue':'red';
 state.board=[false,false,false,false,false];
 state.strikes=0; state.roundPoints=0; state.roundLocked=false;
 state.faceoff={blue:null,red:null}; state.faceoffWinner=null;
 state.phase='faceoff';
}

function startFastMoney(){
 hostStateMutation(()=>{
  if(state.phase!=='fastmoney')return;
  let p=prompt('Nombre del jugador que hará Fast Money:');
  if(!p)return;
  state.fastMoney.player=p; state.fastMoney.index=0; state.fastMoney.answers=[]; state.fastMoney.score=0;
 });
}

function fastAnswer(){
 hostStateMutation(()=>{
  if(!state.fastMoney.player)return;
  const pool=[
   ['Algo que haces al levantarte',['mirar el móvil','baño','lavarse','desayunar'],35],
   ['Una comida que pedirías a domicilio',['pizza','hamburguesa','sushi','kebab'],35],
   ['Algo que llevas a la playa',['toalla','crema','bañador','agua'],30],
   ['Un animal que da miedo',['araña','serpiente','rata','cucaracha'],30],
   ['Algo que haces cuando estás aburrido',['móvil','series','jugar','dormir'],25]
  ];
  const item=pool[state.fastMoney.index];
  let ans=prompt(item[0]+':');
  if(ans===null)return;
  state.fastMoney.answers.push(ans);
  if(item[1].some(x=>ans.toLowerCase().includes(x)))state.fastMoney.score+=item[2];
  state.fastMoney.index++;
  if(state.fastMoney.index>=pool.length){
    state.scores[state.currentTeam]+=state.fastMoney.score;
    state.phase='finished';
  }
 });
}

function finishGame(){hostStateMutation(()=>state.phase='finished')}
function backToLobby(){
 if(host)hostStateMutation(()=>{
   const ps=state.players||[];
   state=baseState(); state.players=ps;
 });
}
function copyRoom(){navigator.clipboard?.writeText(room);alert('Código copiado: '+room)}
function boot(){
 const s=JSON.parse(localStorage.getItem(KEY)||'null');if(s){me=s.me;room=s.room;host=s.host}
}
boot();

</script>
